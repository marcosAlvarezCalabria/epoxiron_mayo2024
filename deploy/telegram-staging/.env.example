STAGING_POSTGRES_PASSWORD=change-only-for-staging
CORS_ORIGIN=http://127.0.0.1:3101
HERMES_BASE_URL=http://127.0.0.1:1
HERMES_SHARED_SECRET=unused-in-staging
GOOGLE_CLIENT_ID=unused-in-staging
JWT_SECRET=replace-with-a-long-random-staging-secret
ALLOWED_EMAILS=staging@example.invalid

VOICE_PARSER_PROVIDER=ollama
VOICE_PARSER_BASE_URL=https://ollama.com
VOICE_PARSER_MODEL=gpt-oss:120b

VOICE_TRANSCRIBER_PROVIDER=google-chirp
VOICE_TRANSCRIBER_MODEL=chirp_3
VOICE_TRANSCRIBER_LANGUAGE=es-ES
VOICE_TRANSCRIBER_TIMEOUT_MS=30000
GOOGLE_CLOUD_PROJECT=epoxiron-499518
GOOGLE_CLOUD_LOCATION=eu
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-cloud-credentials.json

EPOXIRON_TELEGRAM_ALLOWED_USER_IDS=
EPOXIRON_TELEGRAM_POLL_TIMEOUT_SECONDS=25
EPOXIRON_TELEGRAM_PROPOSAL_TTL_MINUTES=30
EPOXIRON_TELEGRAM_MAX_AUDIO_BYTES=20971520
EPOXIRON_TELEGRAM_ECHO_TRANSCRIPTS=true
REPORT_UPLOADS_ENABLED=false
DAILY_REPORT_AUTOMATION_ENABLED=false
EMAIL_NOTIFICATIONS_ENABLED=false
ODOO_INVOICING_ENABLED=false
ODOO_CUSTOMER_SYNC_ENABLED=false
ODOO_RECONCILIATION_ENABLED=false
