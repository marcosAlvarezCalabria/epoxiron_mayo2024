EPOXIRON_TELEGRAM_ALLOWED_USER_IDS=
EPOXIRON_TELEGRAM_POLL_TIMEOUT_SECONDS=25
EPOXIRON_TELEGRAM_PROPOSAL_TTL_MINUTES=30
EPOXIRON_TELEGRAM_MAX_AUDIO_BYTES=20971520
EPOXIRON_TELEGRAM_MAX_IMAGE_BYTES=20971520
EPOXIRON_TELEGRAM_ECHO_IMAGE_TRANSCRIPTIONS=true

IMAGE_READER_PROVIDER=gemini
IMAGE_READER_BASE_URL=https://generativelanguage.googleapis.com/v1beta
IMAGE_READER_MODEL=gemini-3.5-flash-lite
IMAGE_READER_API_KEY=replace-with-gemini-api-key
IMAGE_READER_TIMEOUT_MS=30000
EPOXIRON_TELEGRAM_ECHO_TRANSCRIPTS=true

VOICE_PARSER_PROVIDER=openai-compatible
VOICE_PARSER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
VOICE_PARSER_MODEL=gemini-3.5-flash-lite
VOICE_PARSER_API_KEY=replace-with-gemini-api-key

VOICE_TRANSCRIBER_PROVIDER=google-chirp
VOICE_TRANSCRIBER_MODEL=chirp_3
VOICE_TRANSCRIBER_LANGUAGE=es-ES
VOICE_TRANSCRIBER_TIMEOUT_MS=30000
GOOGLE_CLOUD_PROJECT=epoxiron-499518
GOOGLE_CLOUD_LOCATION=eu
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-cloud-credentials.json
